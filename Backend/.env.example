# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/aloweda
# Ya MongoDB Atlas ka connection string:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/aloweda?retryWrites=true&w=majority

# JWT Secret Key (koi bhi random strong string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Frontend URL (CORS ke liye)
CLIENT_URL=http://localhost:5173

# Admin Configuration
ADMIN_EMAILS=admin@aloweda.com,admin2@aloweda.com

# Feature Configuration
FREE_SHIPPING_THRESHOLD=999
ONLINE_DISCOUNT_PERCENTAGE=10
