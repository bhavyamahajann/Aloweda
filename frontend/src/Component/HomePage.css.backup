/* ─── PAGE ─── */
.page {
  width: 100%;
  background: var(--warm-white);
}

/* ─── HERO SLIDER (split layout: content left, image right) ─── */
.hero {
  position: relative;
  width: 100%;
  height: calc(100vh - 128px);
  min-height: 560px;
  max-height: 780px;
  overflow: hidden;
  background: var(--cream);
}
.hero__track { width: 100%; height: 100%; position: relative; }

.hero__slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.7s ease, visibility 0.7s;
  display: grid;
  grid-template-columns: 1fr 1.15fr;
}
.hero__slide--active { opacity: 1; visibility: visible; z-index: 2; }

/* Left — text panel */
.hero__content-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 0 5vw;
  background: var(--warm-white);
  position: relative;
  z-index: 2;
}

.hero__count,
.hero__tag,
.hero__heading,
.hero__sub,
.hero__content-panel .btn {
  opacity: 0;
  transform: translateY(24px);
}
.hero__slide--active .hero__count {
  animation: heroFadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: 0.15s;
}
.hero__slide--active .hero__tag {
  animation: heroFadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: 0.3s;
}
.hero__slide--active .hero__heading {
  animation: heroFadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: 0.45s;
}
.hero__slide--active .hero__sub {
  animation: heroFadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: 0.6s;
}
.hero__slide--active .hero__content-panel .btn {
  animation: heroFadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  animation-delay: 0.75s;
}
@keyframes heroFadeUp { to { opacity: 1; transform: translateY(0); } }

.hero__count {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 1px;
  color: var(--text-light);
  margin-bottom: 18px;
}
.hero__count em { font-style: normal; color: var(--border); }

.hero__tag {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--green);
  background: var(--green-pale);
  padding: 5px 14px;
  border-radius: 20px;
  margin-bottom: 22px;
}
.hero__heading {
  font-family: 'Comfortaa', serif;
  font-size: clamp(42px, 5vw, 68px);
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: -1px;
  color: var(--text-dark);
  margin-bottom: 16px;
}
.hero__sub {
  font-size: 16px;
  color: var(--text-mid);
  font-weight: 300;
  letter-spacing: 0.5px;
  margin-bottom: 40px;
  max-width: 380px;
}

/* Right — image panel */
.hero__image-panel {
  position: relative;
  overflow: hidden;
}
.hero__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center !important;
  background-repeat: no-repeat;
  transform: scale(1.1);
  transition: transform 6.5s ease-out;
}
.hero__slide--active .hero__bg { transform: scale(1); }

.hero__image-fade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, var(--warm-white) 0%, rgba(250,248,244,0) 8%);
  pointer-events: none;
}

/* Arrows */
.hero__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid var(--border);
  box-shadow: 0 8px 24px rgba(44, 36, 22, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-dark);
  transition: background 0.25s, transform 0.25s, box-shadow 0.25s;
  cursor: pointer;
}
.hero__arrow:hover {
  background: var(--text-dark);
  color: var(--warm-white);
  transform: translateY(-50%) scale(1.06);
}
.hero__arrow--prev { left: calc(5vw - 60px); }
.hero__arrow--next { right: 32px; }

/* Progress bars */
.hero__progress {
  position: absolute;
  bottom: 36px;
  left: 5vw;
  display: flex;
  gap: 10px;
  z-index: 10;
}
.hero__progress-bar {
  position: relative;
  width: 46px;
  height: 3px;
  border-radius: 2px;
  background: rgba(44, 36, 22, 0.15);
  border: none;
  cursor: pointer;
  overflow: hidden;
  padding: 0;
}
.hero__progress-fill {
  position: absolute;
  inset: 0;
  background: var(--gold);
  transform-origin: left;
  animation: progressFill 6s linear forwards;
}
@keyframes progressFill {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}
.hero__progress-bar--active { background: rgba(44, 36, 22, 0.15); }

@media (max-width: 900px) {
  .hero__slide { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
  .hero__content-panel { padding: 32px 24px 24px; text-align: left; }
  .hero__image-panel { min-height: 260px; }
  .hero__image-fade { background: linear-gradient(to bottom, var(--warm-white) 0%, rgba(250,248,244,0) 10%); }
  .hero__arrow--prev { left: 12px; }
  .hero__arrow--next { right: 12px; }
  .hero__progress { left: 24px; }
}
@media (max-width: 600px) {
  .hero { max-height: none; height: auto; }
  .hero__content-panel { padding: 28px 16px 16px; }
  .hero__sub { margin-bottom: 24px; }
  .hero__arrow { width: 38px; height: 38px; }
}

/* ─── BUTTONS ─── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 32px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  border: 1.5px solid transparent;
  cursor: pointer;
  transition: all 0.25s ease;
  white-space: nowrap;
  text-decoration: none;
}
.btn--dark { background: var(--text-dark); color: var(--cream); border-color: var(--text-dark); }
.btn--dark:hover { background: var(--green); border-color: var(--green); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(74,124,89,0.3); }
.btn--white { background: white; color: var(--text-dark); border-color: white; }
.btn--white:hover { background: var(--cream); }
.btn--outline-dark { background: transparent; color: var(--text-dark); border-color: var(--text-dark); }
.btn--outline-dark:hover { background: var(--text-dark); color: var(--cream); transform: translateY(-1px); }
.btn--sm { padding: 10px 20px; font-size: 11px; letter-spacing: 1px; }
.btn--lg { padding: 16px 48px; font-size: 13px; }

/* ─── MARQUEE ─── */
.marquee-strip { background: var(--text-dark); color: var(--cream); overflow: hidden; padding: 12px 0; }
.marquee-track { display: flex; animation: marquee-scroll 30s linear infinite; width: max-content; }
.marquee-item { padding: 0 40px; font-size: 12px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; white-space: nowrap; border-right: 1px solid rgba(245,240,232,0.2); }
@keyframes marquee-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.marquee-strip:hover .marquee-track { animation-play-state: paused; }

/* ─── SECTION COMMON ─── */
.section { 
  padding: 96px 40px; 
  max-width: 1280px; 
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.section__header { 
  text-align: center; 
  margin-bottom: 56px;
  width: 100%;
  box-sizing: border-box;
}

.section__header--left { text-align: left; }
.section__eyebrow { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
.section__title { font-family: 'Comfortaa', serif; font-size: clamp(36px, 4vw, 52px); font-weight: 400; letter-spacing: -0.5px; color: var(--text-dark); margin-bottom: 12px; line-height: 1.1; }
.section__desc { font-size: 15px; color: var(--text-light); font-weight: 300; max-width: 400px; margin: 0 auto; line-height: 1.6; }
.section__header--left .section__desc { margin: 0; }
.section__cta { text-align: center; margin-top: 52px; }

/* Reduce bottom padding for best-sellers to eliminate gap above ImageCarousel */
.best-sellers { padding-bottom: 40px; }

/* ─── CATEGORIES ─── */
.categories-section { background: var(--cream); border-radius: 24px; }
.categories-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; }
.category-card { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 28px 16px; background: var(--warm-white); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; transition: all 0.25s ease; }
.category-card:hover { background: var(--green-pale); border-color: var(--green-light); transform: translateY(-3px); box-shadow: var(--shadow-soft); }
.category-card__icon { width: 48px; height: 48px; background: var(--cream-dark); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; color: var(--green); font-weight: 600; }
.category-card:hover .category-card__icon { background: var(--green); color: white; }
.category-card__label { font-size: 12px; font-weight: 600; letter-spacing: 0.5px; color: var(--text-dark); text-align: center; }
@media (max-width: 900px) { .categories-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 500px) { .categories-grid { grid-template-columns: repeat(2, 1fr); } }

/* ─── WHY ALOWEDA ─── */
.why-section { 
  background: var(--cream-darker); 
  border-radius: 0;
  padding: 80px 60px;
  margin: 80px 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

.why-section__inner { 
  display: grid; 
  grid-template-columns: 1fr 2fr; 
  gap: 80px; 
  align-items: start;
  max-width: 1400px;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}

.pillars-grid { 
  display: grid; 
  grid-template-columns: repeat(2, 1fr); 
  gap: 32px;
  row-gap: 32px;
  width: 100%;
  box-sizing: border-box;
}

.pillar-card { 
  padding: 32px 28px; 
  background: var(--warm-white); 
  border: 1px solid var(--border); 
  border-radius: 12px; 
  transition: box-shadow 0.3s, transform 0.3s;
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.pillar-card:hover { 
  box-shadow: var(--shadow-soft); 
  transform: translateY(-2px); 
}

.pillar-card__icon { 
  font-size: 32px; 
  margin-bottom: 16px; 
}

.pillar-card__title { 
  font-family: 'Comfortaa', serif; 
  font-size: 20px; 
  font-weight: 500; 
  color: var(--text-dark); 
  margin-bottom: 10px; 
}

.pillar-card__desc { 
  font-size: 14px; 
  color: var(--text-light); 
  line-height: 1.7; 
}

/* Tablet */
@media (max-width: 1024px) { 
  .why-section {
    padding: 70px 40px;
  }
  
  .why-section__inner { 
    grid-template-columns: 1fr; 
    gap: 50px; 
  }
  
  .pillars-grid {
    gap: 28px;
    row-gap: 28px;
  }
  
  .why-section .section__header--left { 
    text-align: center; 
  }
  
  .why-section .section__desc { 
    margin: 0 auto; 
  }
}

/* Mobile */
@media (max-width: 768px) {
  .why-section {
    padding: 48px 16px;
    margin: 48px 0;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }
  
  .why-section__inner {
    gap: 32px;
    width: 100%;
  }
  
  .why-section .section__title {
    font-size: clamp(28px, 6vw, 36px);
  }
  
  .why-grid {
    gap: 20px;
  }
  
  .why-card {
    padding: 24px 16px;
  }
  
  .why-card__icon {
    width: 48px;
    height: 48px;
  }
  
  .why-card__title {
    font-size: 16px;
  }
  
  .why-card__desc {
    font-size: 13px;
  }

  .pillars-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  
  .pillar-card {
    padding: 28px 24px;
  }
  
  .pillar-card__icon {
    font-size: 28px;
    margin-bottom: 14px;
  }
  
  .pillar-card__title {
    font-size: 19px;
  }
  
  .pillar-card__desc {
    font-size: 13px;
  }
}


/* ─── TESTIMONIALS ─── */
.testimonials-section { background: var(--warm-white); }
.testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.testimonial-card { padding: 32px 28px; background: var(--cream); border: 1px solid var(--border); border-radius: 16px; transition: box-shadow 0.3s; }
.testimonial-card:hover { box-shadow: var(--shadow-soft); }
.testimonial-card__stars { color: var(--gold); font-size: 16px; letter-spacing: 2px; margin-bottom: 16px; }
.testimonial-card__text { font-family: 'Comfortaa', serif; font-size: 17px; font-style: italic; color: var(--text-mid); line-height: 1.7; margin-bottom: 20px; }
.testimonial-card__author { display: flex; flex-direction: column; gap: 2px; }
.testimonial-card__name { font-size: 13px; font-weight: 600; color: var(--text-dark); }
.testimonial-card__loc { font-size: 12px; color: var(--text-light); }
@media (max-width: 900px) { .testimonials-grid { grid-template-columns: 1fr; } }
@media (max-width: 600px) { 
  .section { 
    padding: 48px 16px;
    width: 100%;
    margin: 0;
    overflow-x: hidden;
  }
  
  .section__header {
    margin-bottom: 32px;
  }
  
  .section__title {
    font-size: clamp(28px, 6vw, 36px);
  }
}


/* ─── ALOWEDA INTRO SECTION ─── */
.aloweda-intro {
  background: linear-gradient(135deg, #faf8f4 0%, #f5f2eb 100%);
  padding: 120px 48px 140px;
  margin: 80px 0;
  position: relative;
}

.aloweda-intro::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--border), transparent);
}

.aloweda-intro::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--border), transparent);
}

.aloweda-intro__container {
  max-width: 1000px;
  margin: 0 auto;
  text-align: center;
}

.aloweda-intro__title {
  font-family: 'Comfortaa', serif;
  font-size: 52px;
  font-weight: 600;
  color: var(--text-dark);
  line-height: 1.3;
  margin-bottom: 40px;
  letter-spacing: -1px;
  min-height: 70px;
}

.aloweda-intro__title.typing::after {
  content: '|';
  animation: blink 0.7s infinite;
  margin-left: 2px;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

.aloweda-intro__description {
  font-size: 18px;
  line-height: 1.9;
  color: var(--text-mid);
  margin-bottom: 50px;
  text-align: center;
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
  min-height: 200px;
}

.aloweda-intro__description.typing::after {
  content: '|';
  animation: blink 0.7s infinite;
  margin-left: 2px;
}

.aloweda-intro__btn {
  background: var(--cream);
  color: var(--text-dark);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  padding: 18px 56px;
  border: 2px solid var(--text-dark);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
  font-family: 'Comfortaa', sans-serif;
  box-shadow: 0 4px 12px rgba(44, 36, 22, 0.1);
  animation: fadeInUp 0.5s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.aloweda-intro__btn:hover {
  background: var(--text-dark);
  color: var(--warm-white);
  border-color: var(--text-dark);
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(44, 36, 22, 0.2);
}

/* Responsive */
@media (max-width: 768px) {
  .aloweda-intro {
    padding: 60px 16px 80px;
    margin: 48px 0;
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }

  .aloweda-intro__container {
    max-width: 100%;
    width: 100%;
    padding: 0;
  }

  .aloweda-intro__title {
    font-size: clamp(24px, 7vw, 32px);
    min-height: auto;
    margin-bottom: 24px;
  }

  .aloweda-intro__description {
    font-size: 15px;
    line-height: 1.7;
    min-height: auto;
    margin-bottom: 32px;
    padding: 0 8px;
  }

  .aloweda-intro__btn {
    width: 100%;
    max-width: 280px;
    padding: 14px 28px;
    font-size: 12px;
  }
}

@media (max-width: 480px) {
  .aloweda-intro {
    padding: 48px 12px 60px;
    margin: 32px 0;
  }

  .aloweda-intro__title {
    font-size: 22px;
  }

  .aloweda-intro__description {
    font-size: 14px;
    padding: 0 4px;
  }

  .aloweda-intro__btn {
    max-width: 100%;
    padding: 12px 24px;
  }
}



/* ─── LOOK BOOK SLIDER SECTION ─── */
.lookbook-section {
  padding: 0;
  background: var(--warm-white);
}

.lookbook-container {
  max-width: 1400px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 600px;
}

/* Left side - Background slider */
.lookbook-left {
  position: relative;
  overflow: hidden;
}

.lookbook-bg {
  width: 100%;
  height: 100%;
  background-size: cover;
  background-position: center;
  position: relative;
}

.lookbook-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.1) 0%,
    rgba(0, 0, 0, 0.3) 100%
  );
}

.lookbook-category {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 32px;
  font-weight: 600;
  color: white;
  text-align: center;
  z-index: 2;
  letter-spacing: -0.5px;
}

/* Slider arrows */
.lookbook-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.9);
  border: none;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 3;
  color: var(--text-dark);
}

.lookbook-arrow:hover {
  background: white;
  transform: translateY(-50%) scale(1.1);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.lookbook-arrow--prev {
  left: 20px;
}

.lookbook-arrow--next {
  right: 20px;
}

/* Right side - Products */
.lookbook-right {
  background: white;
  padding: 60px 40px;
  overflow-y: auto;
}

.lookbook-title {
  font-size: 42px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 40px;
  letter-spacing: -0.5px;
}

.lookbook-products {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.lookbook-product {
  display: flex;
  gap: 20px;
  cursor: pointer;
  transition: all 0.3s ease;
  padding: 16px;
  border-radius: 12px;
}

.lookbook-product:hover {
  background: var(--warm-white);
  transform: translateX(4px);
}

.lookbook-product__img {
  width: 120px;
  height: 120px;
  flex-shrink: 0;
  border-radius: 8px;
  overflow: hidden;
  background: var(--warm-white);
}

.lookbook-product__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.lookbook-product__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
}

.lookbook-product__name {
  font-size: 15px;
  font-weight: 500;
  color: var(--text-dark);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  cursor: pointer;
  transition: color 0.2s ease;
}

.lookbook-product__name:hover {
  color: var(--green);
}

.lookbook-product__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 4px;
}

.lookbook-product__price {
  font-size: 16px;
  font-weight: 600;
  color: var(--green);
}

.lookbook-product__img {
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.lookbook-product__img:hover {
  opacity: 0.8;
}

/* Responsive */
@media (max-width: 1024px) {
  .lookbook-container {
    grid-template-columns: 1fr;
  }

  .lookbook-left {
    min-height: 500px;
  }

  .lookbook-right {
    padding: 50px 30px;
  }

  .lookbook-title {
    font-size: 36px;
  }
}

@media (max-width: 768px) {
  .lookbook-section {
    padding: 0;
    margin: 0;
    width: 100%;
    overflow-x: hidden;
  }

  .lookbook-container {
    max-width: 100%;
    margin: 0;
    padding: 0;
  }

  .lookbook-left {
    min-height: 300px;
    width: 100%;
  }

  .lookbook-right {
    padding: 32px 16px;
    width: 100%;
    box-sizing: border-box;
  }

  .lookbook-title {
    font-size: 28px;
    margin-bottom: 24px;
    padding: 0;
  }

  .lookbook-category {
    font-size: 24px;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
  }

  .lookbook-arrow {
    width: 36px;
    height: 36px;
  }

  .lookbook-arrow svg {
    width: 18px;
    height: 18px;
  }

  .lookbook-arrow--prev {
    left: 12px;
  }

  .lookbook-arrow--next {
    right: 12px;
  }

  .lookbook-products {
    gap: 20px;
  }

  .lookbook-product {
    padding: 12px;
    gap: 12px;
  }

  .lookbook-product__img {
    width: 90px;
    height: 90px;
  }

  .lookbook-product__info {
    gap: 6px;
  }

  .lookbook-product__name {
    font-size: 13px;
    line-height: 1.3;
  }

  .lookbook-product__price {
    font-size: 14px;
  }

  .lookbook-product__footer {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .lookbook-product__footer .btn {
    width: 100%;
    justify-content: center;
    font-size: 12px;
    padding: 8px 16px;
  }
}

@media (max-width: 480px) {
  .lookbook-left {
    min-height: 250px;
  }

  .lookbook-right {
    padding: 24px 12px;
  }

  .lookbook-title {
    font-size: 24px;
    margin-bottom: 20px;
  }

  .lookbook-category {
    font-size: 20px;
    bottom: 20px;
  }

  .lookbook-product {
    padding: 10px;
    gap: 10px;
  }

  .lookbook-product__img {
    width: 80px;
    height: 80px;
  }

  .lookbook-product__name {
    font-size: 12px;
  }

  .lookbook-product__price {
    font-size: 13px;
  }
}